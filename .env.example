# ==========================================
# EcoScan Dual-Mode Global Configuration
# ==========================================

# ------------------------------------------
# 1. Backend (FastAPI) Configuration
# ------------------------------------------
PROJECT_NAME="EcoScan API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000","*"]

# Azure AI Foundry / Azure OpenAI Vision Settings
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_ENDPOINT="https://<your-resource-name>.openai.azure.com/"
AZURE_OPENAI_DEPLOYMENT_NAME="gpt-4o"
AZURE_OPENAI_API_VERSION="2024-08-01-preview"

# Vision Fallback Mode (true = offline heuristic engine active when Azure keys omitted)
MOCK_VISION_FALLBACK=true
MAX_IMAGE_SIZE_BYTES=10485760

# MongoDB Persistence Settings (Production Build)
# Default connects to local MongoDB daemon; fallback to isolated persistence if unreachable
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB_NAME="ecoscan_prod"

# Clerk Authentication Settings (Production Build)
# Obtain from Clerk Dashboard (https://dashboard.clerk.com) > API Keys
CLERK_SECRET_KEY=""
CLERK_PUBLISHABLE_KEY=""
CLERK_ISSUER=""           # e.g., https://clerk.your-domain.com or https://<instance>.clerk.accounts.dev
CLERK_JWKS_URL=""         # Optional (defaults to ${CLERK_ISSUER}/.well-known/jwks.json)
CLERK_PEM_PUBLIC_KEY=""   # Optional RSA PEM public key from Clerk Dashboard > API Keys > Show JWT public key

# Clerk Dashboard Requirements:
# - User Authentication: Enable Email Address as required identifier
# - Email Verification: Required email verification code (OTP) upon sign-up
# - Authentication Session: Production API independently validates JWT signature

# ------------------------------------------
# 2. Frontend (Vite + React) Configuration
# ------------------------------------------
VITE_API_BASE_URL="http://localhost:8000"

# Clerk Publishable Key (Production Build)
# Starts with pk_test_ or pk_live_. Required to access Production Mode.
VITE_CLERK_PUBLISHABLE_KEY=""
