# ==========================================
# EcoScan Backend Environment Variables
# ==========================================

# Application Settings
PROJECT_NAME="EcoScan API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# CORS Configuration (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000","*"]

# Azure AI Foundry / Azure OpenAI Vision Configuration
# Obtain credentials from Azure Portal > Azure OpenAI Service > Keys and Endpoint
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_ENDPOINT="https://<your-resource-name>.openai.azure.com/"
AZURE_OPENAI_DEPLOYMENT_NAME="gpt-4o"
AZURE_OPENAI_API_VERSION="2024-08-01-preview"

# Vision Fallback Mode:
# When true, if Azure credentials are missing or the API call fails/times out,
# the service gracefully uses a high-fidelity local garment classifier.
MOCK_VISION_FALLBACK=true

# Upload Limits (in bytes, default 10MB)
MAX_IMAGE_SIZE_BYTES=10485760
