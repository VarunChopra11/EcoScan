# ==========================================
# EcoScan Frontend Environment Variables
# ==========================================

# Backend API Base URL (leave empty in dev to utilize Vite reverse proxy, or set http://localhost:8000)
VITE_API_BASE_URL=""

# Clerk Publishable Key (Production Build)
# Obtain from Clerk Dashboard > API Keys (starts with pk_test_ or pk_live_)
# When configured, enables real Clerk email authentication and persistent MongoDB storage.
# When omitted, Production Mode guides the developer with setup instructions and provides 1-click access to the Test Build.
VITE_CLERK_PUBLISHABLE_KEY=""
