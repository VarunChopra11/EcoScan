# ==========================================
# EcoScan Frontend Environment Variables
# ==========================================

# Backend API Base URL (leave empty in dev to utilize Vite reverse proxy)
VITE_API_BASE_URL=""

# Clerk Publishable Key (Production Build)
# Obtain from Clerk Dashboard > API Keys (starts with pk_test_ or pk_live_)
# When omitted, the app provides an interactive developer authentication selector
VITE_CLERK_PUBLISHABLE_KEY=""
